# LLM Provider Configuration (gemini, openai, groq, or ollama)
LLM_PROVIDER=gemini

# API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Ollama Configuration
OLLAMA_API_BASE=http://localhost:11434

# Model Selection (must be <= 10B parameters)
# Examples:
# - gemini: gemini-1.5-flash-8b
# - openai: gpt-4o-mini
# - groq: llama-3.1-8b-instant
# - ollama: qwen2.5:7b, llama3.1:8b
MODEL_NAME=gemini-1.5-flash-8b
